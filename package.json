{
  "name": "scalpel-plugin-gem-scanner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node -e \"require('fs').copyFileSync('manifest.json', 'dist/manifest.json')\"",
    "dev": "vite build --watch",
    "typecheck": "tsc",
    "test": "vitest run",
    "build:refs": "tsx scripts/build-gem-refs.ts",
    "bundle": "npm run build && node scripts/bundle-into-scalpel.mjs",
    "sim": "tsx scripts/simulate-scan.ts"
  },
  "dependencies": {
    "@icon-park/react": "^1.4.2",
    "@scalpelpoe/plugin-sdk": "^0.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
